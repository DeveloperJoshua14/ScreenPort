# Copy this file to .env OUTSIDE the public document root. Never commit .env.
APP_ENV=production
APP_URL=https://screenport.example.com
SCREENPORT_DOMAIN=screenport.example.com
# Exact trusted proxy addresses only. Leave blank for direct CyberPanel TLS.
TRUSTED_PROXY_IPS=
# Generated by: php bin/console.php init
APP_KEY=
STORAGE_PATH=

# Your existing qBittorrent_*, JellyFin_*, and OpenAI_APIKEY names are also supported.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_SEARCH_PLUGINS=enabled
# Prefer magnets. Only add trusted PUBLIC HTTPS hosts for torrent files; never LAN addresses.
TORRENT_ALLOWED_HOSTS=
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
TMDB_READ_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

REGION=US
TIMEZONE=America/New_York
MOVIE_ROOT=/media/Movies
TV_ROOT=/media/TV Shows
MATURE_TV_ROOT=/media/Mature TV Shows
MATURE_RATINGS=TV-MA,R,NC-17,18,18+
UNKNOWN_RATING_MATURE=true
MOVIE_GENRE_MAP={}

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ScreenPort
DOWNLOAD_MANAGER_EMAIL=

REGISTRATION_OPEN=true
DOWNLOADS_ENABLED=true
REQUEST_LIMIT_PER_DAY=10
SELECTION_MIN_CONFIDENCE=0.85
MAX_TORRENT_GB=250
SEARCH_TIMEOUT=45
