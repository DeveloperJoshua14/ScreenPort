# Copy this file to .env OUTSIDE the public document root. Never commit .env.
APP_ENV=production
APP_URL=https://screenport.example.com
SCREENPORT_DOMAIN=screenport.example.com
# Exact trusted proxy addresses only. Leave blank for direct CyberPanel TLS.
TRUSTED_PROXY_IPS=
# Generated by: php bin/console.php init
APP_KEY=
STORAGE_PATH=

# Your existing qBittorrent_*, JellyFin_*, and OpenAI_APIKEY names are also supported.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_SEARCH_PLUGINS=enabled
# Prefer magnets. Only add trusted PUBLIC HTTPS hosts for torrent files; never LAN addresses.
TORRENT_ALLOWED_HOSTS=
JELLYFIN_URL=http://jellyfin:8096
# Optional browser-reachable server base URL (no /web suffix or credentials).
# Leave blank to use JELLYFIN_URL for the Open in Jellyfin button.
JELLYFIN_PUBLIC_URL=
JELLYFIN_API_KEY=
TMDB_READ_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

REGION=US
TIMEZONE=America/New_York
MOVIE_ROOT=/media/Movies
TV_ROOT=/media/TV Shows
MATURE_TV_ROOT=/media/Mature TV Shows
MATURE_RATINGS=TV-MA,R,NC-17,18,18+
UNKNOWN_RATING_MATURE=true
# Existing folders are qBittorrent destinations under MOVIE_ROOT, not Windows drive letters.
MOVIE_EXISTING_FOLDERS="Action,Adults,Adventure,Divergent,Drama,Harry Potter,Horror,Hunger Games,James Bond,Kids,Marvel Cinematic Universe,Maze Runner,Murder Mysteries,Other,Pirates of the Caribbean,Romance,RomCom,Star Wars,Twilight,X-Men"
# Automatic routing uses existing folders only. Enable this only for explicit custom overrides.
# A new destination triggers a separate download-manager email to check Jellyfin.
ALLOW_NEW_MOVIE_FOLDERS=false
MOVIE_FOLDER_OVERRIDES={}
MOVIE_GENRE_MAP={}

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ScreenPort
DOWNLOAD_MANAGER_EMAIL=
# Blank uses DOWNLOAD_MANAGER_EMAIL. Pending account requests notify this recipient.
ACCOUNT_MANAGER_EMAIL=

REGISTRATION_OPEN=true
DOWNLOADS_ENABLED=true
# Also alert when qBittorrent accepts a torrent but no data transfers within this many minutes.
DOWNLOAD_START_TIMEOUT_MINUTES=10
REQUEST_LIMIT_PER_DAY=10
SELECTION_MIN_CONFIDENCE=0.85
# Assume original audio for ordinary releases without conflicting audio labels.
# Set false to require explicit original-language audio labels (many releases omit these).
ASSUME_ORIGINAL_AUDIO=true
MAX_TORRENT_GB=250
# Upper TV size budget; computed from actual season episode counts and average runtime.
TV_MAX_GIB_PER_HOUR=2
SEARCH_TIMEOUT=45
